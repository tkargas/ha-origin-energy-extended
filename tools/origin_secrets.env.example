# Copy this to `origin_secrets.env` and fill in your own value:
#
#   cp origin_secrets.env.example origin_secrets.env
#
# The real file is git-ignored. Load it and run a script with:
#
#   set -a; . tools/origin_secrets.env; set +a
#   docker exec -i -e ORIGIN_SESSION_COOKIE \
#       homeassistant python3 /tmp/origin_energy_test/test_login.py
#
# `docker exec -e VAR` with no `=value` forwards the value from your
# current shell, so the cookie reaches the container without being typed
# on a command line or landing in your shell history.
#
# No password is needed -- Origin's password endpoint sits behind Kasada
# bot defence and always answers a script with HTTP 429. Paste the value
# of the `auth0` cookie for id.originenergy.com.au instead, copied from a
# browser where you are signed in. See ../docs/session-cookie.md.
#
# This cookie is a live session credential: anyone holding it is signed
# in as you. Treat it like a password.

export ORIGIN_SESSION_COOKIE="paste-the-auth0-cookie-value-here"
